{
  "name": "kriya-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "knex migrate:latest --knexfile src/config/knexfile.cjs",
    "migrate:rollback": "knex migrate:rollback --knexfile src/config/knexfile.cjs",
    "seed": "knex seed:run --knexfile src/config/knexfile.cjs",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@kriya/shared": "*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "mysql2": "^3.12.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "resend": "^6.17.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "eslint": "*",
    "prettier": "*"
  }
}
