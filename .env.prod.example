# ─── Database ──────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_USER=kriya
DB_PASSWORD=change-me-user-password
DB_NAME=kriya_prod
DB_ROOT_PASSWORD=change-me-root-password

# ─── Authentication ───────────────────────────────
JWT_SECRET=generate-a-random-256-bit-key-here-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Encryption (for API keys) ────────────────────
# Must be exactly 64 hex characters (32 bytes / 256 bits)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── Server ────────────────────────────────────────
# SERVER_PORT is the HOST port exposed (bound to 127.0.0.1) for direct API access.
# Inside the container the API always listens on port 3000 (proxied by the client
# nginx at /api), so do not change the container-side port.
SERVER_PORT=3000

# CLIENT_PORT is the HOST port for the web client nginx (bound to 127.0.0.1).
# 8080 avoids colliding with a host-level Nginx/certbot listening on 80/443.
# Point your reverse proxy (Nginx/Caddy/etc.) at http://127.0.0.1:8080.
CLIENT_PORT=8080

HOST=0.0.0.0
NODE_ENV=production

# Must be the PUBLIC origin users reach the app from, e.g. https://kriya.example.com
# Leave blank/omitted only when accessing directly via http://127.0.0.1:8080.
CORS_ORIGIN=https://your-domain.com

# ─── Email (Resend) ────────────────────────────────
# Required to send verification emails. If you omit RESEND_API_KEY, new
# registrations are auto-verified so the app stays usable.
# Sign up at https://resend.com to get an API key
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Public base URL of the app (used in verification email links), e.g.
# https://kriya.example.com
APP_URL=https://your-domain.com
