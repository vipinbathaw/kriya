# ─── Database ──────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_USER=kriya
DB_PASSWORD=change-me-user-password
DB_NAME=kriya_prod
DB_ROOT_PASSWORD=change-me-root-password

# ─── Authentication ───────────────────────────────
JWT_SECRET=generate-a-random-256-bit-key-here-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Encryption (for API keys) ────────────────────
# Must be exactly 64 hex characters (32 bytes / 256 bits)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── Server ────────────────────────────────────────
PORT=3000
SERVER_PORT=3000
CLIENT_PORT=80
NODE_ENV=production
CORS_ORIGIN=http://localhost

# ─── Email (Resend) ────────────────────────────────
# Sign up at https://resend.com to get an API key
# RESEND_API_KEY=re_xxxxxxxxxxxx
APP_URL=http://localhost
